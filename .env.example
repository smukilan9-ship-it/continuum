# Persistence (server-only)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=10
BLOB_READ_WRITE_TOKEN=

# Featherless model routing (server-only)
# NOTE: Featherless removed its public /v1/models catalogue endpoint (now 404
# "Gone"), so live discovery is unavailable on the current plan and these model
# IDs are used directly. The IDs below are live-verified to return real,
# non-empty completions (Qwen2.5 family). Set IDs that are actually available to
# your Featherless plan; forward-dated IDs return empty 200 responses.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct
FEATHERLESS_FAST_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_REASONING_MODEL=Qwen/Qwen2.5-72B-Instruct
FEATHERLESS_CODE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_VERIFIER_MODEL=Qwen/Qwen2.5-72B-Instruct
# Used only if live catalog discovery is unavailable. This public model id is not a secret.
FEATHERLESS_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
FEATHERLESS_MODEL_ALLOWLIST=Qwen/Qwen2.5-7B-Instruct,Qwen/Qwen2.5-72B-Instruct,Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_MODEL_CONCURRENCY_COST=1
FEATHERLESS_CONCURRENCY_UNITS=4

# Direct Gemini failover pool (server-only; never expose as NEXT_PUBLIC_*)
# Multiple keys improve credential failover. Gemini quotas are enforced per project,
# so keys from one project do not multiply the project's rate limit.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
# The router discovers the account's real generateContent models at runtime and
# health-checks them, so a temporarily-503 or unavailable default is skipped.
# gemini-flash-lite-latest is live-verified fast + clean; set any model your keys
# can actually call (avoid IDs that 404 with "no longer available to new users").
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_CONCURRENCY=2
GEMINI_DATA_USE_ACKNOWLEDGED=false

# Embeddings and optional server-local Ollama
EMBEDDING_PROVIDER=gemini,featherless,ollama,ai_gateway
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
OLLAMA_BASE_URL=
OLLAMA_EMBEDDING_MODEL=
ALLOW_REMOTE_OLLAMA=false
RETRIEVAL_COSINE_THRESHOLD=0.6

# Optional fallbacks (server-only)
AI_GATEWAY_API_KEY=
AI_GATEWAY_ENABLED=false
AI_GATEWAY_GENERAL_MODEL=google/gemini-3.5-flash
AI_GATEWAY_MULTIMODAL_MODEL=google/gemini-3.5-flash
AI_GATEWAY_FALLBACK_MODELS=openai/gpt-5.4,anthropic/claude-sonnet-4.6
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=qwen/qwen3.6-27b
GROQ_CODE_MODEL=openai/gpt-oss-120b
GROQ_VERIFIER_MODEL=openai/gpt-oss-20b

# Authentication and remote MCP OAuth (server-only)
MCP_OAUTH_ISSUER_URL=
MCP_JWT_SIGNING_SECRET=
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local MCP Inspector only. Ignored in production.
MCP_DEMO_TOKEN=
MCP_DEMO_USER_ID=user_maya
SESSION_PRIVACY_SALT=

# App and abuse controls
APP_BASE_URL=http://localhost:3000
PUBLIC_REGISTRATION_ENABLED=false
# Auto-seed the "Maya" acceptance fixture on first DB access. Defaults to on in
# development and OFF in production so a real deployment is never seeded with a
# demo user/goals. Set to true only to load the fixture (e.g. an acceptance env).
CONTINUUM_SEED_DEMO=false
PER_USER_DAILY_TOKEN_CAP=50000
MCP_REQUESTS_PER_MINUTE=120
AI_REQUESTS_PER_MINUTE=30
# Live provider health-probe endpoint (GET /api/ai/status)
AI_STATUS_REQUESTS_PER_MINUTE=20
INTEGRATION_STATUS_REQUESTS_PER_MINUTE=30
INTEGRATION_WRITES_PER_HOUR=20
STATE_WRITES_PER_HOUR=180
STATE_READS_PER_MINUTE=120
SESSION_READS_PER_MINUTE=120
LEARNING_ACTIONS_PER_HOUR=120
RESOURCE_READS_PER_MINUTE=60
RESOURCE_ACTIONS_PER_HOUR=120
SCHEDULE_ACTIONS_PER_HOUR=60
PROPOSAL_REVIEWS_PER_HOUR=60
SOURCE_UPLOADS_PER_HOUR=20
SOURCE_READS_PER_MINUTE=60
SOURCE_DELETES_PER_HOUR=30
RETRIEVAL_REQUESTS_PER_MINUTE=60
MEMORY_SEARCH_REQUESTS_PER_MINUTE=60
OBSIDIAN_SYNC_REQUESTS_PER_MINUTE=120
OAUTH_REGISTRATIONS_PER_HOUR=30
OAUTH_TOKEN_REQUESTS_PER_MINUTE=60
OAUTH_REVOCATIONS_PER_MINUTE=60
OAUTH_AUTHORIZATIONS_PER_HOUR=60
LOGOUTS_PER_MINUTE=20
