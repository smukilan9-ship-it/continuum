    "@remotion/shapes": "4.0.500",
    "@remotion/transitions": "4.0.500",
    "react": "19.1.8",
    "react-dom": "19.1.8",
    "remotion": "4.0.500"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.500",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
