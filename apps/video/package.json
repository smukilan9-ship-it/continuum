{
  "name": "@continuum/video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render",
    "still": "remotion still",
    "build": "remotion bundle",
    "render:all": "node scripts/render-all.mjs",
    "render:labels": "node scripts/render-all.mjs --labels",
    "manifest:check": "node scripts/render-all.mjs --check",
    "cutlist": "node scripts/build-cutlist.mjs",
    "conform": "node scripts/make-fcpxml.mjs",
    "vo": "node scripts/make-vo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "music": "node scripts/make-music.mjs",
    "sfx": "node scripts/make-sfx.mjs",
    "mix": "node scripts/make-mix.mjs",
    "tts": "node scripts/gemini-tts.mjs",
    "animatic": "node scripts/make-animatic.mjs",
