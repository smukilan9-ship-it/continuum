{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- turbo dev --filter=@continuum/web",
    "dev:seeded": "turbo dev --filter=@continuum/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "node scripts/visual-qa-premium.mjs",
    "e2e:flow": "node scripts/e2e-flow.mjs",
    "db:generate": "pnpm --filter @continuum/db generate",
    "db:migrate": "dotenv -e .env.local -- pnpm --filter @continuum/db exec drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- pnpm --filter @continuum/db seed",
    "seed:demo": "dotenv -e .env.local -- pnpm --filter @continuum/db seed:demo",
    "env:pull": "vercel env pull .env.local --yes",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^30.0.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3",
    "vercel": "56.3.1",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  }
}
